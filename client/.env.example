VITE_API_URL=http://localhost:5000/api

# Optional: enables Google sign-in on login/register
# Get this from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Session expiry in hours (should match JWT token expiry on backend)
VITE_SESSION_EXPIRY_HOURS=1

# Footer details. Anything left empty is hidden.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_X_URL=
VITE_LINKEDIN_URL=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
VITE_PORTFOLIO_URL=

# Company account shown to instructors paying their commission
VITE_BANK_DETAILS=
