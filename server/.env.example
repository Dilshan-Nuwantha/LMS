# Copy to .env for local use. On Render, add these under Environment.
# Never commit real values.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=

# Long random strings
JWT_SECRET=
AI_ENCRYPTION_KEY=
CRON_SECRET=

# Frontend address, used for CORS and payment/invite links
CLIENT_URL=http://localhost:5173

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe card payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Password reset email.
# With BREVO_API_KEY set, mail goes through Brevo's HTTP API (needed on Render's free plan,
# which blocks SMTP). EMAIL_FROM must be a verified sender in Brevo.
# Without it, Gmail SMTP is used with EMAIL_USER and an app password in EMAIL_PASS.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# Render keep-alive (Render sets RENDER_EXTERNAL_URL itself)
KEEP_ALIVE=false
